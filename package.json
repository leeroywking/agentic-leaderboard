{
  "name": "agentic-leaderboard-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "node": "node_modules/node/bin/node --version",
    "dev": "node_modules/node/bin/node node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "npm run generate:badges && node_modules/node/bin/node node_modules/vite/bin/vite.js build && npm run prerender",
    "build:client": "node_modules/node/bin/node node_modules/vite/bin/vite.js build",
    "prerender": "node_modules/node/bin/node scripts/prerender.mjs",
    "generate:badges": "node_modules/node/bin/node scripts/generate-badges.mjs",
    "smoke:api": "node_modules/node/bin/node scripts/smoke-api.mjs",
    "preview": "node_modules/node/bin/node node_modules/vite/bin/vite.js preview --host 0.0.0.0"
  },
  "dependencies": {
    "@octokit/core": "^7.0.6",
    "@upstash/redis": "^1.37.0",
    "node": "^22.12.0",
    "resend": "^6.12.0",
    "stripe": "^22.0.2",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "jsdom": "^29.0.2"
  }
}
