# Agentic Leaderboard — environment contract
# Copy to .env (local) or paste into Vercel → Project → Settings → Environment Variables.
# Every variable below can be omitted for partial deploys; the backend
# degrades gracefully (logs instead of sending email, 503s the Stripe
# endpoints, in-memory fallback instead of persistence).

# --- Public site ---
PUBLIC_SITE_URL=https://agenticleaderboard.org

# --- Admin ---
# Any long random string. Used to gate /admin.html and the admin API.
ADMIN_TOKEN=replace-with-long-random-string

# --- Stripe ---
# Test keys look like sk_test_... ; live keys look like sk_live_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One Stripe price id per tier. Create these in the Stripe dashboard.
# Verified: $149/year recurring
# Certified: $499 one-time (we bill the next year manually via email invoice
#   until we implement renewals)
# Pilot: $299/month recurring
# Standard: $999/month recurring
STRIPE_PRICE_VERIFIED=
STRIPE_PRICE_CERTIFIED=
STRIPE_PRICE_PILOT=
STRIPE_PRICE_STANDARD=

# --- Resend (transactional email) ---
# Resend API key + a verified sending address on your domain.
RESEND_API_KEY=
RESEND_FROM="Agentic Leaderboard <hello@agenticleaderboard.org>"
RESEND_REVIEW_INBOX=hello@agenticleaderboard.org

# --- Upstash Redis (persistence) ---
# Provision via Vercel Marketplace → Upstash Redis → free tier.
# Both the UPSTASH_* and KV_* names are supported (Vercel KV migration).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- GitHub (review queue) ---
# PAT with "repo" scope on the review-queue repo. Private repo fine.
# Format: owner/repo
GITHUB_TOKEN=
GITHUB_REVIEW_REPO=leeroywking/agentic-leaderboard-review
